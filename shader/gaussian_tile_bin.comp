#version 430 core

// Tile binning pass. Scatters sorted splats into fixed-size per-tile lists using
// a conservative projected footprint. This prepares data for tile-local raster.
layout(local_size_x = 256) in;

uniform samplerBuffer dataBuffer;
uniform usamplerBuffer packedDataBuffer;  // RGBA32UI for packed/ext splats
uniform mat4 view;
uniform mat4 proj;
uniform vec2 viewport_size;
uniform int activeCount;
uniform int tileCountX;
uniform int tileCountY;
uniform int tileSize;
uniform int tileListCapacity;
uniform int tileListPerTileCapacity;
uniform int usePackedEncoding;   // 0=legacy, 1=PackedSplat(16B), 2=ExtSplat(32B)
uniform int dispatchGroupsX;
uniform float supportRadiusScale;
uniform float maxScreenRadius;
uniform float clipXY;               // NDC guard band half-width (default 2.0)

uniform bool useSparkPagedPool;

// Splat edit uniforms
uniform bool enableSplatEdit;
uniform usampler2D sdfTexture;
uniform int numSdfs;
uniform int numEdits;
uniform vec4 editData[8];

layout(std430, binding = 2) readonly buffer SortIndexBuffer
{
    int sortIndices[];
};

layout(std430, binding = 3) buffer TileCountBuffer
{
    uint tileCounts[];
};

layout(std430, binding = 4) buffer TileCursorBuffer
{
    uint tileCursors[];
};

layout(std430, binding = 5) buffer TileListBuffer
{
    int tileList[];
};

layout(std430, binding = 6) buffer TileStatsBuffer
{
    uint tileStats[];
};

// Half-float decode
float fromHalf(uint h)
{
    uint sign = (h >> 15) & 1u;
    uint exp = (h >> 10) & 0x1fu;
    uint frac = h & 0x3ffu;
    uint f32bits;
    if (exp == 0u) {
        if (frac == 0u) {
            f32bits = sign << 31u;
        } else {
            uint mant = frac;
            int e = -14;
            while ((mant & 0x400u) == 0u) { mant <<= 1u; e--; }
            mant &= 0x3ffu;
            f32bits = (sign << 31u) | (uint(e + 127) << 23u) | (mant << 13u);
        }
    } else if (exp == 0x1fu) {
        f32bits = (frac == 0u) ? ((sign << 31u) | 0x7f800000u) : ((sign << 31u) | 0x7fc00000u);
    } else {
        f32bits = (sign << 31u) | ((exp - 15u + 127u) << 23u) | (frac << 13u);
    }
    return uintBitsToFloat(f32bits);
}

const float LN_SCALE_MIN = -12.0;
const float LN_SCALE_MAX = 9.0;
const float LN_SCALE_SCALE = (LN_SCALE_MAX - LN_SCALE_MIN) / 254.0;

float decodeScaleLn0R8(uint encoded)
{
    if (encoded == 0u) return 0.0;
    return exp(LN_SCALE_MIN + float(encoded - 1u) * LN_SCALE_SCALE);
}

// Decode position and max scale directly from packed buffers using physical index
void decodePosAndMaxScalePhysical(int physicalIdx, out vec3 position, out float maxScale)
{
    if (usePackedEncoding == 1) {
        uvec4 w = texelFetch(packedDataBuffer, physicalIdx);
        position = vec3(fromHalf(w.y & 0xffffu), fromHalf((w.y >> 16u) & 0xffffu), fromHalf(w.z & 0xffffu));
        float sx = decodeScaleLn0R8(w.w & 0xffu);
        float sy = decodeScaleLn0R8((w.w >> 8u) & 0xffu);
        float sz = decodeScaleLn0R8((w.w >> 16u) & 0xffu);
        maxScale = max(sx, max(sy, sz));
    } else if (usePackedEncoding == 2) {
        uvec4 extA = texelFetch(packedDataBuffer, physicalIdx * 2);
        uvec4 extB = texelFetch(packedDataBuffer, physicalIdx * 2 + 1);
        position = vec3(uintBitsToFloat(extA.x), uintBitsToFloat(extA.y), uintBitsToFloat(extA.z));
        float sx = exp(fromHalf((extB.y >> 16u) & 0xffffu));
        float sy = exp(fromHalf(extB.z & 0xffffu));
        float sz = exp(fromHalf((extB.z >> 16u) & 0xffffu));
        maxScale = max(sx, max(sy, sz));
    } else {
        // Legacy path with physical addressing
        int dataBase = physicalIdx * 4;
        vec4 posAlpha = texelFetch(dataBuffer, dataBase + 0);
        vec4 scaleR = texelFetch(dataBuffer, dataBase + 1);
        position = posAlpha.xyz;
        maxScale = max(scaleR.x, max(scaleR.y, scaleR.z));
    }
}

void decodePosAndMaxScale(int splatIndex, out vec3 position, out float maxScale)
{
    if (usePackedEncoding == 1) {
        uvec4 w = texelFetch(packedDataBuffer, splatIndex);
        position = vec3(fromHalf(w.y & 0xffffu), fromHalf((w.y >> 16u) & 0xffffu), fromHalf(w.z & 0xffffu));
        float sx = decodeScaleLn0R8(w.w & 0xffu);
        float sy = decodeScaleLn0R8((w.w >> 8u) & 0xffu);
        float sz = decodeScaleLn0R8((w.w >> 16u) & 0xffu);
        maxScale = max(sx, max(sy, sz));
    } else if (usePackedEncoding == 2) {
        uvec4 extA = texelFetch(packedDataBuffer, splatIndex * 2);
        uvec4 extB = texelFetch(packedDataBuffer, splatIndex * 2 + 1);
        position = vec3(uintBitsToFloat(extA.x), uintBitsToFloat(extA.y), uintBitsToFloat(extA.z));
        float sx = exp(fromHalf((extB.y >> 16u) & 0xffffu));
        float sy = exp(fromHalf(extB.z & 0xffffu));
        float sz = exp(fromHalf((extB.z >> 16u) & 0xffffu));
        maxScale = max(sx, max(sy, sz));
    } else {
        int dataBase = splatIndex * 4;
        vec4 posAlpha = texelFetch(dataBuffer, dataBase + 0);
        vec4 scaleR = texelFetch(dataBuffer, dataBase + 1);
        position = posAlpha.xyz;
        maxScale = max(scaleR.x, max(scaleR.y, scaleR.z));
    }
}

mat3 quatToRotation(vec4 q)
{
    float x = q.x, y = q.y, z = q.z, w = q.w;
    float x2 = x + x, y2 = y + y, z2 = z + z;
    float xx = x * x2, xy = x * y2, xz = x * z2;
    float yy = y * y2, yz = y * z2, zz = z * z2;
    float wx = w * x2, wy = w * y2, wz = w * z2;
    return mat3(
        1.0 - (yy + zz), xy + wz, xz - wy,
        xy - wz, 1.0 - (xx + zz), yz + wx,
        xz + wy, yz - wx, 1.0 - (xx + yy)
    );
}

void writeTile(int tileIndex, int splatIndex)
{
    if (tileIndex < 0 || tileIndex >= tileCountX * tileCountY)
        return;

    uint slot = atomicAdd(tileCursors[tileIndex], 1u);
    atomicAdd(tileCounts[tileIndex], 1u);
    atomicAdd(tileStats[0], 1u);
    if (slot >= uint(tileListPerTileCapacity)) {
        atomicAdd(tileStats[1], 1u);
        return;
    }

    uint listIndex = uint(tileIndex) * uint(tileListPerTileCapacity) + slot;
    if (listIndex < uint(tileListCapacity))
        tileList[int(listIndex)] = splatIndex;
    else
        atomicAdd(tileStats[2], 1u);
}

void main()
{
    uint groupIndex = gl_WorkGroupID.x + gl_WorkGroupID.y * uint(dispatchGroupsX);
    uint globalId = groupIndex * 256u + gl_LocalInvocationID.x;
    if (globalId >= uint(activeCount))
        return;

    int splatIndex = sortIndices[int(globalId)];
    if (splatIndex < 0)
        return;

    vec3 position;
    float maxScale;
    
    if (useSparkPagedPool) {
        decodePosAndMaxScalePhysical(splatIndex, position, maxScale);
    } else {
        decodePosAndMaxScale(splatIndex, position, maxScale);
    }

    if (enableSplatEdit) {
        for (int i = 0; i < numEdits && i < 8; ++i) {
            uvec4 packedEdit = uvec4(floatBitsToUint(editData[i].x),
                                     floatBitsToUint(editData[i].y),
                                     floatBitsToUint(editData[i].z),
                                     floatBitsToUint(editData[i].w));
            applyPackedDisplaceEditOnly(packedEdit, sdfTexture, numSdfs, position);
        }
    }

    vec4 eyePos = view * vec4(position, 1.0);
    if (eyePos.z > 0.0)
        return;

    vec4 clip = proj * eyePos;
    if (clip.w <= 0.0)
        return;

    vec3 ndc = clip.xyz / clip.w;
    if (ndc.x < -clipXY || ndc.x > clipXY || ndc.y < -clipXY || ndc.y > clipXY)
        return;

    vec2 screen;
    screen.x = 0.5 * (viewport_size.x + ndc.x * viewport_size.x);
    screen.y = 0.5 * (viewport_size.y + ndc.y * viewport_size.y);

    float focal = max(proj[0][0] * viewport_size.x, proj[1][1] * viewport_size.y) * 0.5;
    float radiusPixels = clamp(2.8284271 * supportRadiusScale * maxScale * focal / max(1.0e-4, -eyePos.z), 1.0, maxScreenRadius);

    int minTx = clamp(int(floor((screen.x - radiusPixels) / float(tileSize))), 0, tileCountX - 1);
    int maxTx = clamp(int(floor((screen.x + radiusPixels) / float(tileSize))), 0, tileCountX - 1);
    int minTy = clamp(int(floor((screen.y - radiusPixels) / float(tileSize))), 0, tileCountY - 1);
    int maxTy = clamp(int(floor((screen.y + radiusPixels) / float(tileSize))), 0, tileCountY - 1);

    for (int ty = minTy; ty <= maxTy; ++ty) {
        for (int tx = minTx; tx <= maxTx; ++tx) {
            writeTile(ty * tileCountX + tx, splatIndex);
        }
    }
}
