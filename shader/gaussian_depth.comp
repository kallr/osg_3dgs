#version 430 core

// Spark-direction compute skeleton.
// Generates view-space depth keys and matching sort indices from the current
// active index buffer and gaussian data buffer.
layout(local_size_x = 256) in;

uniform samplerBuffer dataBuffer;
uniform usamplerBuffer packedDataBuffer;  // RGBA32UI for packed/ext splats
uniform mat4 view;
uniform int activeCount;
uniform int sortCount;
uniform int usePackedEncoding;   // 0=legacy, 1=PackedSplat(16B), 2=ExtSplat(32B)
uniform bool sortRadial;         // true=sort by radial distance, false=sort by Z-depth

layout(std430, binding = 0) readonly buffer ActiveIndexBuffer
{
    int activeIndices[];
};

layout(std430, binding = 1) buffer DepthKeyBuffer
{
    uint depthKeys[];
};

layout(std430, binding = 2) buffer SortIndexBuffer
{
    int sortIndices[];
};

uint floatDepthKey(float d)
{
    // Depth is non-negative distance along -Z. IEEE float bit order is sortable
    // as uint for non-negative values.
    return floatBitsToUint(max(d, 0.0));
}

float fromHalf(uint h)
{
    uint sign = (h >> 15) & 1u;
    uint exp = (h >> 10) & 0x1fu;
    uint frac = h & 0x3ffu;
    uint f32bits;
    if (exp == 0u) {
        if (frac == 0u) {
            f32bits = sign << 31u;
        } else {
            uint mant = frac;
            int e = -14;
            while ((mant & 0x400u) == 0u) { mant <<= 1u; e--; }
            mant &= 0x3ffu;
            f32bits = (sign << 31u) | (uint(e + 127) << 23u) | (mant << 13u);
        }
    } else if (exp == 0x1fu) {
        f32bits = (frac == 0u) ? ((sign << 31u) | 0x7f800000u) : ((sign << 31u) | 0x7fc00000u);
    } else {
        f32bits = (sign << 31u) | ((exp - 15u + 127u) << 23u) | (frac << 13u);
    }
    return uintBitsToFloat(f32bits);
}

vec3 decodePositionPackedSplat(int idx)
{
    uvec4 w = texelFetch(packedDataBuffer, idx);
    return vec3(fromHalf(w.y & 0xffffu), fromHalf((w.y >> 16u) & 0xffffu), fromHalf(w.z & 0xffffu));
}

vec3 decodePositionExtSplat(int idx)
{
    uvec4 extA = texelFetch(packedDataBuffer, idx * 2);
    return vec3(uintBitsToFloat(extA.x), uintBitsToFloat(extA.y), uintBitsToFloat(extA.z));
}

void main()
{
    uint globalId = gl_GlobalInvocationID.x;
    if (globalId >= uint(sortCount))
        return;

    if (globalId >= uint(activeCount)) {
        // Padded entries sort to the end for descending back-to-front order.
        depthKeys[int(globalId)] = 0u;
        sortIndices[int(globalId)] = -1;
        return;
    }

    int splatIndex = activeIndices[int(globalId)];
    if (splatIndex < 0) {
        depthKeys[int(globalId)] = 0u;
        sortIndices[int(globalId)] = -1;
        return;
    }

    vec3 position;
    if (usePackedEncoding == 1) {
        position = decodePositionPackedSplat(splatIndex);
    } else if (usePackedEncoding == 2) {
        position = decodePositionExtSplat(splatIndex);
    } else {
        position = texelFetch(dataBuffer, splatIndex * 4).xyz;
    }

    vec4 eyePos = view * vec4(position, 1.0);
    float depth;
    if (sortRadial) {
        depth = length(eyePos.xyz);
    } else {
        depth = (eyePos.z > 0.0) ? 0.0 : -eyePos.z;
    }
    depthKeys[int(globalId)] = floatDepthKey(depth);
    sortIndices[int(globalId)] = splatIndex;
}
